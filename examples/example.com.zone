; =============================================================
; MoonDNS Example Zone File (RFC 1035 Master File Format)
; Zone Origin: example.com.
; =============================================================

$ORIGIN example.com.
$TTL 3600

; Start of Authority Record
@ IN SOA ns1.example.com. hostmaster.example.com. (
    2026092001 ; Serial
    7200       ; Refresh (2 hours)
    3600       ; Retry (1 hour)
    1209600    ; Expire (2 weeks)
    3600       ; Minimum / Negative Caching TTL (1 hour)
)

; Authoritative Name Servers
@   IN NS ns1.example.com.
@   IN NS ns2.example.com.

; Name Server IPv4 Addresses (Glue Records)
ns1 IN A 192.0.2.1
ns2 IN A 192.0.2.2

; Apex Records
@   IN A     93.184.216.34
@   IN AAAA  2606:2800:220:1:248:1893:25c8:1946
@   IN MX    10 mail.example.com.
@   IN TXT   "v=spf1 ip4:192.0.2.0/24 -all"

; Web Services & Aliases
www   IN A     93.184.216.34
api   IN A     198.51.100.10
mail  IN A     192.0.2.25
ftp   IN CNAME www.example.com.
docs  IN CNAME www.example.com.

; Wildcard Subdomains
*.dev IN A     127.0.0.1
